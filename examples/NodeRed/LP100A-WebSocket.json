    {
        "id": "lp100aws-fan",
        "type": "function",
        "z": "lp100aws-flow",
        "name": "Fan telemetry",
        "func": "// Fan one telemetry frame to one output per UI widget.\n// Input: msg.payload = { type:\"telemetry\", data:{...} }\nconst d = msg.payload.data || {};\nconst power = Number(d.power_w) || 0;\n\n// Z and Phase are meaningless when the radio isn't keyed; suppress them\n// the same way the original serial flow did (\"--\" placeholder).\nconst dim = (v, decimals) =>\n    power < 0.1 ? \"--\" : Number(v).toFixed(decimals);\n\nconst modeLabel = ({\n    average: \"Average\",\n    peak_hold: \"Peak Hold\",\n    tune: \"Tune\"\n})[d.mode] || \"-\";\n\nreturn [\n    { payload: power },                                       // 1: Watts level\n    { payload: Number(d.swr) || 0 },                          // 2: SWR level\n    { payload: Number(d.dbw) || 0 },                          // 3: dBW level\n    { payload: dim(d.z_ohm, 1) },                             // 4: Z text\n    { payload: dim(d.phase_deg, 1) },                         // 5: Phase text\n    { payload: { range: d.range, power_w: power } },          // 6: Range LEDs + control\n    { payload: modeLabel },                                   // 7: Mode label\n    {                                                         // 8: Alarm label + color\n        payload: d.alarm_setpoint,\n        color: d.alarm_tripped ? \"red\" : \"white\"\n    },\n    { payload: d.callsign }                                   // 9: Callsign\n];\n",
        "outputs": 9,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 290,
        "y": 360,
        "wires": [
            [
                "lp100aws-watts"
            ],
            [
                "lp100aws-swr"
            ],
            [
                "lp100aws-dbw"
            ],
            [
                "lp100aws-z"
            ],
            [
                "lp100aws-phase"
            ],
            [
                "lp100aws-range"
            ],
            [
                "lp100aws-mode"
            ],
            [
                "lp100aws-alarm"
            ],
            [
                "lp100aws-id"
            ]
        ]
    },
    {
        "id": "lp100aws-range",
        "type": "function",
        "z": "lp100aws-flow",
        "name": "Range LEDs",
        "func": "// Drive the Hi/Mid/Lo LEDs and update the Watts level's max scale\n// based on which range the meter reports.\nconst { range, power_w } = msg.payload || {};\n\nlet hi = false, mid = false, lo = false, max = 750;\nswitch (range) {\n    case \"high\": hi = true;  max = 750; break;\n    case \"mid\":  mid = true; max = 125; break;\n    case \"low\":  lo = true;  max = 25;  break;\n}\n\nreturn [\n    { payload: hi },\n    { payload: mid },\n    { payload: lo },\n    { payload: power_w, control: { min: 0, max } }\n];\n",
        "outputs": 4,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 480,
        "wires": [
            [
                "lp100aws-led-hi"
            ],
            [
                "lp100aws-led-mid"
            ],
            [
                "lp100aws-led-lo"
            ],
            [
                "lp100aws-watts"
            ]
        ]
    },
