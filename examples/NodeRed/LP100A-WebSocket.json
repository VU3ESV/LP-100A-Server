    {
        "id": "lp100aws-cmd-build",
        "type": "function",
        "z": "lp100aws-flow",
        "name": "Build command",
        "func": "// Inputs from any of three UI widgets (button or switch).\n// msg.payload is the action verb itself: \"peak_toggle\",\n// \"mode_step\", or \"alarm_step\". Wrap it in the wire-protocol\n// envelope expected by lp100a-server (PROPOSAL.md §4).\nconst id = (Math.random() * 1e9 | 0).toString(36);\nreturn {\n    payload: JSON.stringify({\n        type: \"command\",\n        id,\n        action: msg.payload\n    })\n};\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1090,
        "y": 720,
        "wires": [
            [
                "lp100aws-wsout"
            ]
        ]
    },
