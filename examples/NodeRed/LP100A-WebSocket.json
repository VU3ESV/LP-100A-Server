    {
        "id": "lp100aws-status-fmt",
        "type": "function",
        "z": "lp100aws-flow",
        "name": "Status -> label",
        "func": "// Map node-status events from the websocket nodes to a friendly\n// indicator string for the dashboard. Green = connected, red = down.\nconst s = msg.status || {};\nconst online = s.fill === \"green\";\nreturn {\n    payload: online ? \"ONLINE\" : (s.text || \"OFFLINE\"),\n    color: online ? \"#00ff55\" : \"#e60000\"\n};\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 880,
        "wires": [
            [
                "lp100aws-conn"
            ]
        ]
    },
