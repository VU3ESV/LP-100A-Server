    {
        "id": "fe831b8d7f0724e0",
        "type": "function",
        "z": "c3a4b13122fa4601",
        "name": "SWR/Alarm",
        "func": "var alarm = msg.payload.substr(0,1) \nvar swr = msg.payload.substr(2,6)\nvar alarmcolor\nvar alarmtext\nvar alarmlevel\n\n\nswitch( alarm ) {\n    case \"0\":\n        alarmtext = \"off\" ;\n        alarmlevel = 6 ;\n        break;\n    case \"1\":\n        alarmtext = \"1.5\" ;\n        alarmlevel = 1.5 ;\n        break;\n    case \"2\":\n        alarmtext = \"2.0\" ;\n        alarmlevel =2.0 ;\n        break;\n    case \"3\":\n        alarmtext = \"2.5\" ;\n        alarmlevel = 2.5 ;\n        break;\n    case \"4\":\n        alarmtext = \"3.0\" ;\n        alarmlevel = 3.0 ;\n        break;\n    case \"5\":\n        alarmtext = \"User defined\";\n        alarmlevel = 6 ;\n        break;\n}\n\nalarmcolor = \"white\" ;\nif (swr > alarmlevel ){\n    alarmcolor = \"red\" ;\n}\n\nreturn  { payload : alarmtext, color : alarmcolor } ;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 540,
        "wires": [
            [
                "d31672a5788b8f42"
            ]
        ]
    },
    {
