    {
        "id": "27408e5cb8b51213",
        "type": "function",
        "z": "c3a4b13122fa4601",
        "name": "Power",
        "func": "var power = flow.get ( \"lpa.power\" )\nvar outrange = flow.get( \"outrange\" )\nvar range = parseInt (msg.payload)\nvar pwr = parseFloat(power)\n\nif ( pwr > 0.1 ) {\n    var hangtime = flow.get(\"hangtime\")\n    hangtime++\n\n    if ( outrange > range ) {\n        outrange = range\n        hangtime = 0\n    }\n    if ( outrange == range ) {\n        hangtime = 0\n    }\n    if ( hangtime > 20 ) { // 2 seconds assuming 100 msec polling rate\n        outrange = range\n        hangtime = 0\n    } \n    flow.set(\"outrange\",outrange)\n    flow.set(\"hangtime\", hangtime)\n}\n\nif(outrange == \"0\"){\n    msg.control = {min:0, max:750}\n}\nif(outrange == \"1\"){\n    msg.control = {min:0, max:125}\n}\nif(outrange == \"2\"){\n    msg.control = {min:0, max:25}\n}\nmsg.outrange = outrange\nmsg.payload = power\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is deployed.\n\nflow.set (\"outrange\", 0 ) \nflow.set (\"hangtime\", 0 )",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 820,
        "wires": [
            [
                "89af71c15822f121",
                "818985d4937d520e",
                "f37cf95366cc27b2"
            ]
        ],
        "info": "Adjust the max range values to match your LP100 settings.\nHangtime = 2 second assume polling rate of 100 msec."
    },
